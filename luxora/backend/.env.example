# FASHN.ai Virtual Try-On API Configuration
# Get your API key from: https://fashn.ai/
FASHN_API_KEY=your_actual_fashn_api_key_here

# Model options: tryon-max (recommended) or tryon-v1.6
FASHN_MODEL_NAME=tryon-max

# Timeout in seconds for polling completion
TRYON_TIMEOUT_SECONDS=60

# Optional CORS allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
