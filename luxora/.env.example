# LUXORA — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Virtual Try-On API (required to enable AI garment fitting)
# Point this to your backend server that proxies the try-on provider.
# Your server should accept POST /tryon with multipart form-data:
#   person_image, garment_image_url, product_id, category, color
# And return: { "result_url": "https://..." }
#
# Recommended providers:
#   Fashn.ai:        https://fashn.ai/docs
#   Replicate VTON:  https://replicate.com/cuuupid/idm-vton
#   Kling AI:        https://klingai.com/docs
#
# Keep API keys on your server — NEVER put them here.
VITE_TRYON_API_URL=
